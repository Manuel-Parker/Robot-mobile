#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  info [
    "Servotron : robot mobile autonome (JUNIA)."
    "Modes : pilotage manuel, tracé de formes, suivi de ligne, évitement d'obstacles."
  ]
  title "Servotron"
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material2 "caster"
      coulombFriction [
        0.01
      ]
    }
  ]
}
Viewpoint {
  orientation -0.32994 0.32994 0.88447 1.69326
  position 0 -6 5.2
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 5 5
  floorTileSize 5 5
  floorAppearance PBRAppearance {
    baseColorMap ImageTexture {
      url [
        "textures/servotron_floor.png"
      ]
    }
    roughness 1
    metalness 0
  }
  wallThickness 0.03
  wallHeight 0.15
}

# ---------- Enclos de la zone d'évitement ----------
DEF WALL_NORTH Solid {
  translation -1.35 -0.1 0.075
  children [
    DEF WALL_N_SHAPE Shape {
      appearance DEF WALL_APP PBRAppearance {
        baseColor 0.93 0.92 0.89
        roughness 0.7
        metalness 0
      }
      geometry Box {
        size 2.3 0.03 0.15
      }
    }
  ]
  name "mur nord"
  boundingObject USE WALL_N_SHAPE
}
DEF WALL_EAST Solid {
  translation -0.2 -1.3 0.075
  children [
    DEF WALL_E_SHAPE Shape {
      appearance USE WALL_APP
      geometry Box {
        size 0.03 2.4 0.15
      }
    }
  ]
  name "mur est"
  boundingObject USE WALL_E_SHAPE
}

# ---------- Obstacles ----------
Solid {
  translation -1.9 -0.75 0.1
  rotation 0 0 1 0.3
  children [
    DEF OBS1 Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.28 0.76
        roughness 0.5
        metalness 0
      }
      geometry Box {
        size 0.3 0.3 0.2
      }
    }
  ]
  name "obstacle 1"
  boundingObject USE OBS1
}
Solid {
  translation -0.8 -0.7 0.125
  children [
    DEF OBS2 Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.75 0.6
        roughness 0.6
        metalness 0
      }
      geometry Cylinder {
        height 0.25
        radius 0.12
      }
    }
  ]
  name "obstacle 2"
  boundingObject USE OBS2
}
Solid {
  translation -1.25 -1.65 0.1
  rotation 0 0 1 -0.5
  children [
    DEF OBS3 Shape {
      appearance PBRAppearance {
        baseColor 0.15 0.17 0.23
        roughness 0.5
        metalness 0
      }
      geometry Box {
        size 0.5 0.15 0.2
      }
    }
  ]
  name "obstacle 3"
  boundingObject USE OBS3
}
Solid {
  translation -2.0 -1.95 0.125
  children [
    DEF OBS4 Shape {
      appearance PBRAppearance {
        baseColor 0.55 0.69 1
        roughness 0.5
        metalness 0
      }
      geometry Cylinder {
        height 0.25
        radius 0.15
      }
    }
  ]
  name "obstacle 4"
  boundingObject USE OBS4
}
Solid {
  translation -0.6 -2.0 0.1
  rotation 0 0 1 0.8
  children [
    DEF OBS5 Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.75 0.6
        roughness 0.6
        metalness 0
      }
      geometry Box {
        size 0.25 0.25 0.2
      }
    }
  ]
  name "obstacle 5"
  boundingObject USE OBS5
}

# ---------- Servotron ----------
DEF SERVOTRON Robot {
  translation -1.35 0.5 0
  children [
    # Plateau inférieur
    Pose {
      translation 0 0 0.052
      children [
        DEF PLATE Shape {
          appearance PBRAppearance {
            baseColor 0.82 0.66 0.45
            roughness 0.85
            metalness 0
          }
          geometry Cylinder {
            height 0.006
            radius 0.14
          }
        }
      ]
    }
    # Plateau supérieur (plateau de transport)
    Pose {
      translation 0 0 0.125
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.88 0.74 0.54
            roughness 0.85
            metalness 0
          }
          geometry Cylinder {
            height 0.006
            radius 0.14
          }
        }
      ]
    }
    # Entretoises
    DEF STANDOFF Pose {
      translation 0.07 0.09 0.0885
      children [
        DEF STANDOFF_SHAPE Shape {
          appearance PBRAppearance {
            baseColor 0.8 0.65 0.3
            roughness 0.3
            metalness 0.8
          }
          geometry Cylinder {
            height 0.067
            radius 0.004
          }
        }
      ]
    }
    Pose {
      translation 0.07 -0.09 0.0885
      children [
        USE STANDOFF_SHAPE
      ]
    }
    Pose {
      translation -0.07 0.09 0.0885
      children [
        USE STANDOFF_SHAPE
      ]
    }
    Pose {
      translation -0.07 -0.09 0.0885
      children [
        USE STANDOFF_SHAPE
      ]
    }
    # Carte ESP32
    Pose {
      translation 0.02 0.035 0.058
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.08 0.08 0.1
            roughness 0.5
            metalness 0
          }
          geometry Box {
            size 0.052 0.028 0.005
          }
        }
      ]
    }
    # Batterie
    Pose {
      translation -0.05 -0.025 0.0675
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.2 0.22 0.25
            roughness 0.6
            metalness 0
          }
          geometry Box {
            size 0.07 0.04 0.025
          }
        }
      ]
    }
    # Moteurs (TT jaunes)
    Pose {
      translation 0 0.11 0.035
      children [
        DEF MOTOR_SHAPE Shape {
          appearance PBRAppearance {
            baseColor 0.95 0.78 0.1
            roughness 0.5
            metalness 0
          }
          geometry Box {
            size 0.065 0.022 0.019
          }
        }
      ]
    }
    Pose {
      translation 0 -0.11 0.035
      children [
        USE MOTOR_SHAPE
      ]
    }
    # Capteur ultrason HC-SR04 (avant)
    Pose {
      translation 0.118 0 0.068
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.3 0.75
            roughness 0.5
            metalness 0
          }
          geometry Box {
            size 0.004 0.045 0.02
          }
        }
      ]
    }
    DEF TRANSDUCER Pose {
      translation 0.124 0.013 0.068
      rotation 0 1 0 1.5708
      children [
        DEF TRANSDUCER_SHAPE Shape {
          appearance PBRAppearance {
            baseColor 0.8 0.8 0.82
            roughness 0.3
            metalness 0.9
          }
          geometry Cylinder {
            height 0.012
            radius 0.008
          }
        }
      ]
    }
    Pose {
      translation 0.124 -0.013 0.068
      rotation 0 1 0 1.5708
      children [
        USE TRANSDUCER_SHAPE
      ]
    }
    # Support des capteurs de ligne
    Pose {
      translation 0.1 0 0.032
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.35 0.2
            roughness 0.6
            metalness 0
          }
          geometry Box {
            size 0.015 0.06 0.04
          }
        }
      ]
    }

    # ---------- Roues ----------
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0.152 0.035
      }
      device [
        RotationalMotor {
          name "left wheel motor"
          acceleration 20
          maxVelocity 14
        }
        PositionSensor {
          name "left wheel sensor"
        }
      ]
      endPoint Solid {
        translation 0 0.152 0.035
        children [
          DEF WHEEL Pose {
            rotation 1 0 0 1.5708
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.12 0.12 0.13
                  roughness 0.9
                  metalness 0
                }
                geometry Cylinder {
                  height 0.022
                  radius 0.035
                }
              }
              Shape {
                appearance PBRAppearance {
                  baseColor 0.92 0.92 0.92
                  roughness 0.5
                  metalness 0
                }
                geometry Cylinder {
                  height 0.024
                  radius 0.018
                }
              }
            ]
          }
        ]
        name "left wheel"
        boundingObject DEF WHEEL_BO Pose {
          rotation 1 0 0 1.5708
          children [
            Cylinder {
              height 0.022
              radius 0.035
            }
          ]
        }
        physics DEF WHEEL_PHYSICS Physics {
          density -1
          mass 0.08
        }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 -0.152 0.035
      }
      device [
        RotationalMotor {
          name "right wheel motor"
          acceleration 20
          maxVelocity 14
        }
        PositionSensor {
          name "right wheel sensor"
        }
      ]
      endPoint Solid {
        translation 0 -0.152 0.035
        children [
          USE WHEEL
        ]
        name "right wheel"
        boundingObject USE WHEEL_BO
        physics USE WHEEL_PHYSICS
      }
    }

    # ---------- Roues folles (collision : voir boundingObject du robot) ----------
    Pose {
      translation 0.11 0 0.0155
      children [
        DEF CASTER_SHAPE Shape {
          appearance PBRAppearance {
            baseColor 0.75 0.75 0.78
            roughness 0.2
            metalness 0.9
          }
          geometry Sphere {
            radius 0.015
            subdivision 2
          }
        }
      ]
    }
    Pose {
      translation -0.11 0 0.0155
      children [
        USE CASTER_SHAPE
      ]
    }

    # ---------- Capteurs ----------
    DistanceSensor {
      translation 0.13 0 0.068
      name "sonar"
      type "sonar"
      lookupTable [
        0 0 0
        2 2 0
      ]
      numberOfRays 1
    }
    DistanceSensor {
      translation 0.12 0.06 0.06
      rotation 0 0 1 0.6
      children [
        DEF IR_SHAPE Shape {
          appearance PBRAppearance {
            baseColor 0.05 0.05 0.05
            roughness 0.4
            metalness 0
          }
          geometry Box {
            size 0.008 0.016 0.008
          }
        }
      ]
      name "ir left"
      lookupTable [
        0 1000 0
        0.35 0 0
      ]
      aperture 0.1
    }
    DistanceSensor {
      translation 0.12 -0.06 0.06
      rotation 0 0 1 -0.6
      children [
        USE IR_SHAPE
      ]
      name "ir right"
      lookupTable [
        0 1000 0
        0.35 0 0
      ]
      aperture 0.1
    }
    DEF GS_LEFT DistanceSensor {
      translation 0.1 0.02 0.012
      rotation 0 1 0 1.5708
      name "gs left"
      type "infra-red"
      lookupTable [
        0 1000 0
        0.06 0 0
      ]
    }
    DistanceSensor {
      translation 0.1 0 0.012
      rotation 0 1 0 1.5708
      name "gs center"
      type "infra-red"
      lookupTable [
        0 1000 0
        0.06 0 0
      ]
    }
    DistanceSensor {
      translation 0.1 -0.02 0.012
      rotation 0 1 0 1.5708
      name "gs right"
      type "infra-red"
      lookupTable [
        0 1000 0
        0.06 0 0
      ]
    }

    # ---------- Stylo (tracé des formes) ----------
    Pen {
      translation 0 0 0.002
      name "pen"
      inkColor 0.1 0.28 0.76
      inkDensity 1
      leadSize 0.014
      write FALSE
    }
  ]
  name "Servotron"
  contactMaterial "caster"
  boundingObject Group {
    children [
      Pose {
        translation 0.11 0 0.0155
        children [
          Sphere {
            radius 0.015
          }
        ]
      }
      Pose {
        translation -0.11 0 0.0155
        children [
          Sphere {
            radius 0.015
          }
        ]
      }
      Pose {
        translation 0 0 0.052
        children [
          Cylinder {
            height 0.006
            radius 0.14
          }
        ]
      }
      Pose {
        translation 0 0 0.125
        children [
          Cylinder {
            height 0.006
            radius 0.14
          }
        ]
      }
    ]
  }
  physics Physics {
    density -1
    mass 1.3
    centerOfMass [
      0 0 0.04
    ]
  }
  controller "servotron"
  supervisor TRUE
  window "servotron_window"
}
